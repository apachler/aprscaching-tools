  "license": "MIT",
  "type": "module",
  "description": "The project tool registry for APRScaching 1.x: signed, sandboxed tools for the Shack's Tools app",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
