{
  "name": "aprscaching-tools",
  "private": true,
  "version": "1.4.0",
  "license": "MIT",
  "type": "module",
  "description": "The project tool registry for APRScaching 1.x: signed, sandboxed tools for the Shack's Tools app",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch-libs": "node scripts/fetch-libs.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "vitest": "5.0.3"
  }
}
